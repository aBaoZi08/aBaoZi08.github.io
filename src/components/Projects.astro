---

<section id="projects">
  <h2>Projects</h2>
  <div class="grid">
    {projects.map((p) => <ProjectCard {...p} />)}
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
</style>
