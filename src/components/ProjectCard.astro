---
// One card. Projects.astro uses this once per project, passing props in.
const { title, description, link } = Astro.props;
---

<article class="card">
  <h3>{title}</h3>
  <p>{description}</p>
  <a href={link}>View project</a>
</article>

<style>
  .card {
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 1rem;
  }
  h3 {
    margin-top: 0;
  }
</style>
